{
  "manifest_version": 3,
  "name": "LEA Infoscreen – FF Deutsch Haslau",
  "description": "Eigene Darstellung des LEA-Infoscreens für die FF Deutsch Haslau. Liest nur mit, was die Seite selbst lädt.",
  "version": "0.11.3",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://www.feuerwehr-krems.at/*",
    "https://einsatz.lsz-b.at/*",
    "https://www.noe.gv.at/*",
    "https://calendar.google.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://hc-ping.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://lea-screen.notrufnoe.at/*"],
      "js": ["config.js", "config.local.js", "inject.js", "render.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://lea-screen.notrufnoe.at/*"],
      "js": ["bridge.js"],
      "css": ["skin.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://lea-screen.notrufnoe.at/*"]
    }
  ]
}
